{
    "schema": 1,
    "id": "IconExport",
    "name": "Icon Export",
    "version": "1.0.0",
    "description": "Adds a /icons command that copies every emoji and sticker of the server you are in as a Markdown table, JSON or a plain list of links.",
    "origin": "testcord",
    "license": "GPL-3.0-or-later",
    "authors": [
        { "name": "x2b", "role": "original author" },
        { "name": "Neversleeper", "github": "https://github.com/Neversleeper", "role": "Amiricord port" }
    ],
    "credits": [
        { "name": "Vendicated and contributors (Vencord), plugin IconExport by x2b", "license": "GPL-3.0-or-later", "url": "https://github.com/TestcordDev/TestCord" }
    ],
    "tags": ["utility"],
    "enabledByDefault": false,
    "startAt": "domReady",
    "entry": { "renderer": "index.ts" },
    "permissions": {
        "system": {
            "clipboard": true
        }
    }
}
