{
    "schema": 1,
    "id": "Define",
    "name": "Define",
    "version": "1.0.0",
    "description": "Adds a /define command that looks up an English word in a dictionary and shows its meanings in a window, only to you.",
    "origin": "testcord",
    "license": "GPL-3.0-or-later",
    "authors": [
        { "name": "Sharp", "role": "original author" },
        { "name": "Neversleeper", "github": "https://github.com/Neversleeper", "role": "Amiricord port" }
    ],
    "credits": [
        { "name": "Vendicated and contributors (Vencord), plugin Define by Sharp", "license": "GPL-3.0-or-later", "url": "https://github.com/TestcordDev/TestCord" }
    ],
    "tags": ["chat", "utility"],
    "enabledByDefault": false,
    "startAt": "domReady",
    "entry": { "renderer": "index.ts" },
    "permissions": {
        "network": [
            {
                "host": "api.dictionaryapi.dev",
                "from": "renderer",
                "why": "get the meanings of the word you typed"
            }
        ]
    }
}
