{
    "schema": 1,
    "id": "WebhookSend",
    "name": "Webhook Send",
    "version": "1.0.0",
    "description": "Adds a /webhook command that sends a message through a webhook address you give (with a name of your choice).",
    "origin": "testcord",
    "license": "GPL-3.0-or-later",
    "authors": [
        { "name": "x2b", "role": "original author" },
        { "name": "Neversleeper", "github": "https://github.com/Neversleeper", "role": "Amiricord port" }
    ],
    "credits": [
        { "name": "Vendicated and contributors (Vencord), plugin WebhookSend by x2b", "license": "GPL-3.0-or-later", "url": "https://github.com/TestcordDev/TestCord" }
    ],
    "tags": ["utility", "chat"],
    "enabledByDefault": false,
    "startAt": "init",
    "entry": { "renderer": "index.ts" },
    "permissions": {
        "network": [
            {
                "host": "discord.com",
                "from": "renderer",
                "why": "send the message you write to the webhook address you give"
            }
        ]
    }
}
