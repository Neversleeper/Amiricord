{
    "schema": 1,
    "id": "CopyUserMention",
    "name": "Copy User Mention",
    "version": "1.0.0",
    "description": "Adds \"Copy User Mention\" to the right-click menu of a person: it copies their mention (<@id>) to the clipboard.",
    "origin": "equicord",
    "license": "GPL-3.0-or-later",
    "authors": [
        { "name": "Cortex", "role": "original author" },
        { "name": "castdrian", "role": "original author" },
        { "name": "Neversleeper", "role": "Amiricord port" }
    ],
    "credits": [
        { "name": "Vendicated and contributors (Vencord), Cortex and castdrian (Equicord), plugin CopyUserMention", "license": "GPL-3.0-or-later", "url": "https://github.com/Equicord/Equicord" }
    ],
    "tags": ["chat", "utility"],
    "enabledByDefault": false,
    "startAt": "domReady",
    "entry": { "renderer": "index.ts" },
    "permissions": {
        "system": { "clipboard": true }
    }
}
