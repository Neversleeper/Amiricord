    "license": "GPL-3.0-or-later",
    "authors": [
        { "name": "HypedDomi", "role": "original author" },
        { "name": "Neversleeper", "github": "https://github.com/Neversleeper", "role": "Amiricord port" }
    ],
    "credits": [
        { "name": "Vendicated and contributors (Vencord), plugin FriendCodes by HypedDomi", "license": "GPL-3.0-or-later", "url": "https://github.com/Equicord/Equicord" }
    ],
    "tags": ["utility"],
    "enabledByDefault": false,
    "startAt": "domReady",
    "entry": { "renderer": "index.ts" },
    "permissions": {
        "system": {
            "clipboard": true
        }
    }
}
