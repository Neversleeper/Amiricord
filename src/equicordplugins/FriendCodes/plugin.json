{
    "schema": 1,
    "id": "FriendCodes",
    "name": "Friend Codes",
    "version": "1.0.0",
    "description": "Adds a /friendcodes command that opens a window with your friend codes: you can make a new one, copy the link of one, or revoke them all.",
